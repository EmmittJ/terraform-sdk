<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageTags>aspire integration hosting terraform modules</PackageTags>
    <Description>Wire existing, on-disk Terraform modules into an Aspire AppHost: Aspire values in as variables, Terraform outputs out as Aspire values.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <EnableAspireIntegrationAnalyzers>true</EnableAspireIntegrationAnalyzers>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" />
  </ItemGroup>

</Project>
